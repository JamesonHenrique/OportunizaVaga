# Ritmo (pacing) do bot — copie o que quiser para o seu ambiente/cron.env.
# Todos os valores são SEGUNDOS. Defaults abaixo = comportamento histórico.
# Aumentar = menos requisições por hora = uso mais conservador e "humano".
# Ver docs/USO-ETICO.md. Deixe comentado para usar o default.

# Timeout de cada rodada (Linux aceita sufixo de tempo; ex.: 20m).
# OV_RUN_TIMEOUT=20m
# No Windows (loop.ps1) o timeout é em segundos:
# OV_RUN_TIMEOUT_SEC=1200

# Sleep após rodada OK com vaga nova (default 1200 = 20min).
# OV_NORMAL_WAIT=1800

# Backoff inicial quando a rodada não achou vaga nova (default 3600 = 1h).
# Dobra a cada rodada vazia, reseta ao achar vaga.
# OV_VAZIA_BASE=5400

# Backoff de falha: base e teto (default 300 e 1800 = 5min e 30min).
# OV_RETRY_BASE=300
# OV_RETRY_MAX=1800

# Perfil ativo (caminho do JSON) — estado isolado em bot/state/<perfil>/.
# BOT_PERFIL=/caminho/para/perfil.json

# Modo reconhecimento: pontua vagas sem se candidatar (default 0).
# OV_RECONHECIMENTO=0

# Limites por rodada (default: 3 candidaturas, 10 vagas em reconhecimento).
# OV_MAX_CANDIDATURAS=3
# OV_RECONHECIMENTO_LIMIT=10

# Telemetria do monitor: agregada por padrão; detalhes brutos só com opt-in.
# OV_TELEMETRY_MODE=aggregate
# OV_MONITOR_INCLUDE_DETAILS=0
