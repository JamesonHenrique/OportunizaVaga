{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/oportunizavaga/perfil.schema.json",
  "title": "Perfil de busca",
  "type": "object",
  "required": ["nome_perfil", "nivel", "termos", "pular_tipos"],
  "properties": {
    "_COMO_USAR": { "type": "string" },
    "nome_perfil": { "type": "string", "minLength": 1 },
    "nivel": { "type": "string", "enum": ["estagio", "trainee", "junior", "júnior", "pleno", "senior", "sênior"] },
    "termos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "pular_tipos": { "type": "array", "items": { "type": "string" } },
    "estado_isolado": { "type": "boolean", "default": true }
  },
  "additionalProperties": true
}
