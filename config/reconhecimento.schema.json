{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/oportunizavaga/reconhecimento.schema.json",
  "title": "Rodada de reconhecimento",
  "type": "object",
  "required": ["perfil", "site", "data", "vagas"],
  "properties": {
    "perfil": { "type": "string" },
    "site": { "type": "string" },
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "vagas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chave", "empresa", "vaga", "url"],
        "properties": {
          "chave": { "type": "string" },
          "empresa": { "type": "string" },
          "vaga": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "score": { "type": "number", "minimum": 0, "maximum": 5 },
          "remota": { "type": "boolean" },
          "nivel": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "motivos": { "type": "array", "items": { "type": "string" } },
          "observacoes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
